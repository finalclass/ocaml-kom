# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Persistent application host, native plugins and files for Kom"
authors: ["Kom contributors"]
homepage: "https://github.com/finalclass/ocaml-kom"
bug-reports: "https://github.com/finalclass/ocaml-kom/issues"
depends: [
  "dune" {>= "3.17"}
  "kom"
  "kom-sqlite"
  "yojson"
  "eio"
  "eio_main"
  "sqlite3"
  "mustache"
  "ezjsonm"
  "ppx_deriving_yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/finalclass/ocaml-kom.git"
