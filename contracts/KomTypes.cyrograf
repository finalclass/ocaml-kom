// # KomTypes — wspólne dane kontraktów
// Ten moduł nie jest usługą ani dodatkową warstwą architektury. Definiuje
// wiadomości współdzielone przez usługi, referencje, deklaratywny model Flow
// oraz wyniki przygotowania i wykonania. Nie enkapsuluje osobnej zmienności
// operacyjnej; jego celem jest jednoznaczny język danych na granicach usług.
// Natywne fasety typowanych modułów OCaml i wersjonowanie snapshotów
// opisuje README.md oraz docs/public-api.md. Referencje procesu są nietrwałe.
struct Problem {
  code: String
  message: String
  path?: String
}

struct Problems {
  items: List<Problem>
}

struct Empty {}

struct SystemRef {
  id: String
}

struct ExecutionRef {
  system: SystemRef
  id: String
}

struct Receipt {
  execution: ExecutionRef
}

variant AdmissionStatus {
  Admitted
  Buffered
}

struct ExistingReceipt {
  receipt: Receipt
  status: AdmissionStatus
}

struct ImplementationRef {
  id: String
  revision: String
}

struct StateRef {
  id: String
}

struct MessageType {
  name: String
  schema_hash: String
}

struct Message {
  type: MessageType
  drut: String
}

struct MessageBatch {
  items: List<Message>
}

struct StateSnapshot {
  state_version: Int
  data: String
}

struct PreparedState {
  value: StateRef
  snapshot: StateSnapshot
}

variant StateLocation {
  Resident(StateRef)
  Stored(StateSnapshot)
}

struct Operation {
  name: String
  input: MessageType
  outputs: List<MessageType>
}

struct CellDefinition {
  implementation: ImplementationRef
  state_version: Int
  operations: List<Operation>
}

struct CellSpec {
  id: String
  implementation: ImplementationRef
  configuration: Record
}

struct CellBinding {
  cell_id: String
  definition: CellDefinition
}

struct FieldSource {
  node_id?: String
  fields: List<String>
}

variant ValueSource {
  Input
  Output(String)
  Field(FieldSource)
  Constant(Message)
}

struct FieldBinding {
  target_fields: List<String>
  source: ValueSource
}

variant InputBinding {
  Whole(ValueSource)
  Fields(List<FieldBinding>)
}

struct StepNode {
  cell_id: String
  operation: String
  input: InputBinding
}

// Użycie nazwanego Flow w tym samym wykonaniu. flow_id jest rozpoznawany
// w katalogu rewizji podczas walidacji; input wiąże wejście fragmentu.
// Identyfikator otaczającego FlowNode stanowi nazwę użycia i zakres kroków.
struct UseNode {
  flow_id: String
  input: InputBinding
}

struct NodeList {
  nodes: List<String>
}

// Wzorzec konstruktora identyfikuje typ wraz z jego schematem oraz nazwę
// konstruktora Cyrografu. Nie porównuje ani nie usuwa payloadu wiadomości.
struct ConstructorPattern {
  type: MessageType
  tag: String
}

variant OutputPattern {
  BoolValue(Bool)
  Constructor(ConstructorPattern)
}

// Przypadek kieruje dopasowane wyjście do korzenia dowolnego poddrzewa Flow.
struct BranchCase {
  output: OutputPattern
  node_id: String
}

// Output w polu from wskazuje identyfikator konkretnego Step albo Use.
// Field pozwala wskazać pole wyniku; reguły wyboru i pokrycia należą do
// FlowEngine.validate i FlowEngine.advance.
struct BranchNode {
  from: ValueSource
  cases: List<BranchCase>
  default_node_id?: String
}

variant NodeBody {
  Step(StepNode)
  Use(UseNode)
  Sequence(NodeList)
  Parallel(NodeList)
  Branch(BranchNode)
}

struct FlowNode {
  id: String
  body: NodeBody
}

struct FlowDefinition {
  root_id: String
  nodes: List<FlowNode>
  input_type?: MessageType
}

struct NamedFlow {
  id: String
  version: Int
  definition: FlowDefinition
}

variant FlowSelector {
  Id(String)
  Inline(FlowDefinition)
}

struct CatalogRef {
  id: String
}

struct StagedCatalog {
  catalog: CatalogRef
  flows: List<NamedFlow>
}

struct CodeStage {
  id: String
  definitions: List<CellDefinition>
}

struct DurableStore {
  location: String
}

variant Storage {
  Memory
  Durable(DurableStore)
}

struct SystemConfiguration {
  storage: Storage
  workers?: Int
}

struct SystemDefinition {
  cells: List<CellSpec>
  flows: List<NamedFlow>
}

struct SystemView {
  system: SystemRef
  revision: String
  cells: List<CellBinding>
  catalog: CatalogRef
}

struct ParentExecution {
  execution: ExecutionRef
  call_id: String
}

struct Entry {
  id: String
  system: SystemRef
  flow: FlowSelector
  message: Message
  parent?: ParentExecution
}

struct ValidatedFlow {
  definition: FlowDefinition
  dependencies: List<NamedFlow>
  system_revision: String
  input_type: MessageType
  output_types: List<MessageType>
  cells: List<CellBinding>
}

// Checkpoint zawiera wyłącznie dane. Wyniki Step są kwalifikowane zakresem Use;
// odtworzenie konstrukcji strukturalnych należy do FlowEngine.
struct NodeResult {
  node_id: String
  messages: MessageBatch
}

struct FlowCheckpoint {
  input: Message
  results: List<NodeResult>
  pending: List<Work>
}

struct FlowProgress {
  format_version: Int
  data: String
}

struct ProgressCheckpoint {
  version: Int
  progress: FlowProgress
}

struct Work {
  id: String
  node_id: String
  branch_path: List<String>
  cell_id: String
  operation: String
  message: Message
}

variant Completion {
  Completed(MessageBatch)
  Failed(Problem)
}

struct ExecutionPlan {
  flow: ValidatedFlow
  progress: FlowProgress
  work: List<Work>
  completion?: Completion
}

struct WorkRef {
  execution: ExecutionRef
  work_id: String
}

struct StepOutput {
  work_id: String
  node_id: String
  branch_path: List<String>
  messages: MessageBatch
}

struct Advancement {
  progress: FlowProgress
  work: List<Work>
  completion?: Completion
}

struct Reservation {
  token: String
  execution: ExecutionRef
  work: Work
  implementation: ImplementationRef
  state: StateLocation
  flow: ValidatedFlow
  progress: FlowProgress
  progress_version: Int
  parent?: ParentExecution
}

struct Retry {
  problem: Problem
  delay_ms: Int
}

variant FailureDecision {
  Retry(Retry)
  Fail(Problem)
}

struct StoredCellState {
  cell_id: String
  implementation: ImplementationRef
  snapshot: StateSnapshot
}

struct PreparedCell {
  cell_id: String
  implementation: ImplementationRef
  state: PreparedState
}

variant QuiescencePurpose {
  Revision
  Closure
}

struct QuiescenceRef {
  system: SystemRef
  token: String
}

struct QuiescentSystem {
  quiescence: QuiescenceRef
  view: SystemView
  definition: SystemDefinition
  configuration: SystemConfiguration
  states: List<StoredCellState>
}

struct NewSystem {
  system: SystemRef
  owner?: SystemRef
  configuration: SystemConfiguration
}

variant ActivationBasis {
  New(NewSystem)
  Quiescent(QuiescenceRef)
}

struct PreparedRevision {
  revision: String
  definition: SystemDefinition
  code: CodeStage
  catalog: CatalogRef
  cells: List<PreparedCell>
  flow_history?: List<NamedFlow>
}

struct ReleasedSystem {
  states: List<StateRef>
  code_stage_id: String
  catalog: CatalogRef
}

struct CreateSystemRequest {
  definition: SystemDefinition
  configuration: SystemConfiguration
  owner?: SystemRef
}

variant CreateSystemResponse {
  Created(SystemView)
  Rejected(Problems)
}

variant SendResponse {
  Admitted(Receipt)
  Buffered(Receipt)
  Rejected(Problems)
}

struct AwaitRequest {
  receipt: Receipt
}

variant AwaitResponse {
  Finished(Completion)
  UnknownReceipt
}

struct CloseSystemRequest {
  system: SystemRef
}

variant CloseSystemResponse {
  Closed
  Rejected(Problem)
}
